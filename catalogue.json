    },
    "hub.open": {
      "tier": "decide",
      "schema": "hitch.person.hub.open",
      "secret": [],
      "closes": [],
      "description": "A one-time link that signs a browser into the team hub's page."
    },
    "policy.set": {
      "tier": "local",
      "schema": "hitch.person.policy.set",
      "secret": [],
      "closes": [],
      "description": "The person's agent policy: which teammates' agents may reach which of their projects over the team hub (inbound exposure), entry by entry. It grants no decision and no always-allow: an entry can't let anything answer a safety kind or send from this machine (the node refuses any field beyond the shape)."
    },
    "sinks.pick": {
      "tier": "local",
      "schema": "hitch.person.sinks.pick",
      "secret": [],
      "closes": [],
      "description": "Pick the to-do sink the mods file to: one of the installed sinks, which the node checks (a sink may be an outside service, so local)."
    },
    "rooms.create": {
      "tier": "local",
      "schema": "hitch.person.rooms.create",
      "secret": [],
      "closes": [],
      "description": "Create a team hub room of the person's, with its members. Room posts stay held decisions (parley.room.post@1)."
    },
    "rooms.live": {
      "tier": "local",
      "schema": "hitch.person.rooms.live",
      "secret": [],
      "closes": [],
      "description": "Turn a room's live delivery on or off. Room posts stay held decisions (parley.room.post@1)."
    },
    "rooms.join": {
      "tier": "local",
