  "personOps": {
    "test.echo": {
      "tier": "local",
      "schema": "hitch.person.test.echo",
      "secret": [
        "secret"
      ],
      "closes": [
        "kernel.connector.signin@1"
      ],
      "testOnly": true,
      "description": "Conformance only: echoes text, reports the secret's length. A node enables it only under its test adapter."
    },
    "connectors.login": {
      "tier": "local",
      "schema": "hitch.person.connectors.login",
      "secret": [],
      "closes": [
        "kernel.connector.signin@1"
      ],
      "description": "Start a connector's sign-in as the person (its oauth or device flow, run by the node; the client opens the URL or shows the code it answers). Closes a session's kernel.connector.signin@1 named in `for`."
    },
    "connectors.secret": {
      "tier": "local",
      "schema": "hitch.person.connectors.secret",
      "secret": [
        "value"
      ],
      "closes": [
        "kernel.connector.signin@1"
      ],
      "description": "Store a token or app secret the person pastes (a token connector, an Outbox sign-in app's secret) in the OS store, straight from the client to the node: never through a session or a decision. `value` is secret."
    },
    "connectors.logout": {
      "tier": "local",
      "schema": "hitch.person.connectors.logout",
      "secret": [],
      "closes": [],
      "description": "Sign a connector out as the person (its stored secret deleted)."
    },
    "reload": {
      "tier": "decide",
      "schema": "hitch.person.reload",
      "secret": [],
      "closes": [
        "kernel.updates.reload@1"
      ],
      "description": "Restart the installed mods' background parts and the service's reloadable code (no new code is fetched). Closes a session's kernel.updates.reload@1 named in `for`."
    },
    "dashboard.link": {
      "tier": "local",
      "schema": "hitch.person.dashboard.link",
      "secret": [],
      "closes": [],
      "description": "A one-time link that signs a browser into the Dashboard (loopback only). Local: until it mints a read-only link (scope read, from P5) the Dashboard carries kernel-own power. The result carries the URL, privacy text."
    },
    "hub.join": {
      "tier": "local",
      "schema": "hitch.person.hub.join",
      "secret": [
        "invite"
      ],
      "closes": [],
      "description": "Join this machine to a team hub with an invite the person holds."
    },
    "hub.leave": {
      "tier": "local",
