{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitch.dev/types/hitch.grant.issue@1.schema.json",
  "title": "hitch.grant.issue@1 (decision kind, floor local)",
  "type": "object", "required": ["kinds", "scope", "ttl", "caps"],
  "properties": {
    "kinds": { "type": "array", "minItems": 1, "items": { "$ref": "hitch.defs.schema.json#/$defs/typeName" } },
    "verbs": { "type": "array", "items": { "type": "string" } },
    "scope": { "type": "object" },
    "ttl": { "type": "integer", "minimum": 60, "description": "seconds" },
    "caps": { "type": "object", "required": ["perHour", "perDay"], "properties": { "perHour": { "type": "integer", "minimum": 1 }, "perDay": { "type": "integer", "minimum": 1 } } }
  }
}
