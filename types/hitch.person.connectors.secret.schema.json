{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitch.dev/types/hitch.person.connectors.secret.schema.json",
  "title": "person op connectors.secret: store a pasted secret",
  "type": "object",
  "required": [
    "service",
    "account",
    "value"
  ],
  "properties": {
    "service": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "account": {
      "type": "string",
      "maxLength": 320
    },
    "value": {
      "type": "string",
      "maxLength": 8192
    },
    "site": {
      "type": "string",
      "maxLength": 500
    }
  },
  "additionalProperties": false
}
