{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitch.dev/types/hitch.item@1.schema.json",
  "title": "hitch.item@1: attention with no buttons",
  "type": "object",
  "required": [
    "spec",
    "id",
    "kind",
    "state",
    "owner",
    "title",
    "created",
    "updated"
  ],
  "properties": {
    "spec": {
      "$ref": "hitch.defs.schema.json#/$defs/spec"
    },
    "id": {
      "type": "string",
      "pattern": "^itm_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "kind": {
      "$ref": "hitch.defs.schema.json#/$defs/typeName"
    },
    "state": {
      "enum": [
        "open",
        "done",
        "dismissed",
        "snoozed"
      ],
      "description": "Explicit state; no TTL. Set by the owner mod, or by a client through an offered item verb."
    },
    "owner": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "level": {
      "enum": [
        "info",
        "warn",
        "error"
      ]
    },
    "link": {
      "type": "string",
      "maxLength": 2000
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^dec_"
      }
    },
    "created": {
      "$ref": "hitch.defs.schema.json#/$defs/time"
    },
    "updated": {
      "$ref": "hitch.defs.schema.json#/$defs/time"
    },
    "sig": {
      "$ref": "hitch.defs.schema.json#/$defs/sig"
    },
    "data": {
      "type": "object",
      "description": "Kind-specific fields, validated against types/<kind>.schema.json when the pack has it (e.g. kernel.inbox@1)."
    },
    "until": {
      "$ref": "hitch.defs.schema.json#/$defs/time",
      "description": "snoozed: when it returns to open"
    },
    "offers": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "verb"
        ],
        "properties": {
          "verb": {
            "enum": [
              "done",
              "dismiss",
              "snooze"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 40
          }
        },
        "additionalProperties": false
      },
      "description": "Item verbs a client may offer as buttons. Narrow: any paired client, no presence. 'Later' is client-local and never reaches the node."
    }
  },
  "description": "Attention that is not consent: a failed job, red CI, a to-do, a review asked of you. It may offer item verbs (done, dismiss, snooze), which change only the item's own state and never run anything as the person. Anything that sends, merges, deploys, signs in or grants is a decision instead."
}
