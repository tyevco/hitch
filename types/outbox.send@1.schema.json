{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitch.dev/types/outbox.send@1.schema.json",
  "title": "outbox.send@1 (decision kind, floor confirm, safety send): bound args",
  "description": "Send an Outbox draft as the person (inventory O1, O2, O3). `send` is REQUIRED and is the bind: the connector driver's bindSend output, the exact bytes the connector sends (text bodies by ref), and each channel accepts only its own shape: teams {body, path} or {body, newChat}, email {mail, to, subject, body|htmlSha}, github {github, body, path}, jira {jira, key, body, path} through connector-jira (hole A6). The node derives the Channel preview row from `send`, never from the requester, and the executor re-checks `send` at claim. Preview rows, in order: To, Channel, Subject, Body. Options: approve 'Send' (confirm), sendBack needsText (decide, verbFloors), decline 'Discard' (narrow).",
  "type": "object",
  "required": [
    "channel",
    "to",
    "body",
    "send"
  ],
  "properties": {
    "channel": {
      "enum": [
        "teams",
        "email",
        "github",
        "jira"
      ]
    },
    "to": {
      "type": "string",
      "maxLength": 320
    },
    "subject": {
      "type": "string",
      "maxLength": 300
    },
    "body": {
      "$ref": "hitch.defs.schema.json#/$defs/ref"
    },
    "send": {
      "type": "object",
      "description": "The connector driver's bindSend output: the bind, re-checked at claim"
    },
    "v2": {
      "$ref": "hitch.defs.schema.json#/$defs/v2bridge"
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "channel": {
          "const": "teams"
        },
        "send": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "body",
                "path"
              ],
              "properties": {
                "body": {
                  "$ref": "hitch.defs.schema.json#/$defs/ref"
                },
                "path": {
                  "type": "string",
                  "maxLength": 400
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "body",
                "newChat"
              ],
              "properties": {
                "body": {
                  "$ref": "hitch.defs.schema.json#/$defs/ref"
                },
                "newChat": {
                  "const": true
                }
              },
              "additionalProperties": false
            }
          ]
        }
      }
    },
    {
      "properties": {
        "channel": {
          "const": "email"
        },
        "send": {
          "type": "object",
          "required": [
            "mail",
            "to",
            "subject"
          ],
          "properties": {
            "mail": {
              "const": true
            },
            "to": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "maxLength": 320
              }
            },
            "subject": {
              "type": "string",
              "maxLength": 300
            },
            "body": {
              "$ref": "hitch.defs.schema.json#/$defs/ref"
            },
            "htmlSha": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "channel": {
          "const": "github"
        },
        "send": {
          "type": "object",
          "required": [
            "github",
            "body",
            "path"
          ],
          "properties": {
            "github": {
              "const": true
            },
            "body": {
              "$ref": "hitch.defs.schema.json#/$defs/ref"
            },
            "path": {
              "type": "string",
              "maxLength": 400
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "channel": {
          "const": "jira"
        },
        "send": {
          "type": "object",
          "required": [
            "jira",
            "key",
            "body",
            "path"
          ],
          "properties": {
            "jira": {
              "const": true
            },
            "key": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]+-[0-9]+$"
            },
            "body": {
              "$ref": "hitch.defs.schema.json#/$defs/ref"
            },
            "path": {
              "type": "string",
              "maxLength": 400
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
