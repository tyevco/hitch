{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitch.dev/types/hitch.grant@1.schema.json",
  "title": "hitch.grant@1: a standing delegation",
  "type": "object",
  "required": ["spec", "id", "kinds", "scope", "expires", "caps", "state", "decision"],
  "properties": {
    "spec": { "$ref": "hitch.defs.schema.json#/$defs/spec" },
    "id": { "type": "string", "pattern": "^gr_[0-9A-HJKMNP-TV-Z]{26}$" },
    "kinds": { "type": "array", "minItems": 1, "items": { "$ref": "hitch.defs.schema.json#/$defs/typeName" }, "description": "Never a kind whose safety is not none." },
    "verbs": { "type": "array", "items": { "type": "string" } },
    "scope": { "type": "object", "description": "Kind-specific narrowing, e.g. {team} for herdr-teams.hire@1." },
    "expires": { "$ref": "hitch.defs.schema.json#/$defs/time" },
    "caps": { "type": "object", "required": ["perHour", "perDay"], "properties": { "perHour": { "type": "integer", "minimum": 1 }, "perDay": { "type": "integer", "minimum": 1 } } },
    "used": { "type": "integer", "minimum": 0 },
    "state": { "enum": ["active", "expired", "revoked"] },
    "decision": { "type": "string", "pattern": "^dec_", "description": "The local decision that created it." }
  }
}
