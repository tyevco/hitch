{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitch.dev/types/hitch.decision@1.schema.json",
  "title": "hitch.decision@1: a decision record",
  "description": "GET /hitch/v1/decisions/:id body, and the data of hitch.decision@1 events. Node-signed. Fields any client can render generically.",
  "type": "object",
  "required": [
    "spec",
    "id",
    "kind",
    "rev",
    "state",
    "owner",
    "requester",
    "title",
    "summary",
    "effect",
    "preview",
    "bind",
    "safety",
    "audience",
    "options",
    "remoteApprove",
    "urgency",
    "expires",
    "onExpire",
    "created",
    "updated"
  ],
  "properties": {
    "spec": {
      "$ref": "hitch.defs.schema.json#/$defs/spec"
    },
    "id": {
      "type": "string",
      "pattern": "^dec_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "kind": {
      "$ref": "hitch.defs.schema.json#/$defs/typeName"
    },
    "rev": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "open",
        "answered",
        "resolved"
      ],
      "description": "open: awaiting an answer. answered: an option was chosen, action pending. resolved: has an outcome."
    },
    "outcome": {
      "$ref": "hitch.defs.schema.json#/$defs/outcome"
    },
    "answered": {
      "type": "object",
      "required": [
        "verb",
        "by",
        "at"
      ],
      "properties": {
        "verb": {
          "type": "string"
        },
        "by": {
          "$ref": "hitch.defs.schema.json#/$defs/principal"
        },
        "device": {
          "type": "string"
        },
        "at": {
          "$ref": "hitch.defs.schema.json#/$defs/time"
        },
        "where": {
          "type": "string",
          "description": "resolved-elsewhere only: the vendor client, e.g. herdr"
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^act_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "state": {
          "$ref": "hitch.defs.schema.json#/$defs/actionState"
        },
        "leaseUntil": {
          "$ref": "hitch.defs.schema.json#/$defs/time"
        },
        "error": {
          "type": "string",
          "maxLength": 2000
        },
        "invokedAt": {
          "$ref": "hitch.defs.schema.json#/$defs/time"
        }
      }
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "requester": {
      "type": "object",
      "required": [
        "principal"
      ],
      "properties": {
        "principal": {
          "$ref": "hitch.defs.schema.json#/$defs/principal"
        },
        "session": {
          "type": "string"
        },
        "member": {
          "type": "string"
        }
      }
    },
    "title": {
      "type": "string",
      "maxLength": 200,
      "description": "Mod-supplied. Render QUOTED under the owner label."
    },
    "summary": {
      "type": "string",
      "maxLength": 2000,
      "description": "Mod-supplied, may be empty. Render QUOTED."
    },
    "effect": {
      "type": "string",
      "maxLength": 300,
      "description": "Node-derived from kind and bound args. The only trusted description."
    },
    "preview": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "$ref": "hitch.defs.schema.json#/$defs/previewRow"
      }
    },
    "bind": {
      "type": "object",
      "required": [
        "alg",
        "hash"
      ],
      "properties": {
        "alg": {
          "const": "sha256/v1"
        },
        "hash": {
          "$ref": "hitch.defs.schema.json#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "safety": {
      "$ref": "hitch.defs.schema.json#/$defs/safety"
    },
    "audience": {
      "oneOf": [
        {
          "const": "person"
        },
        {
          "type": "object",
          "required": [
            "member"
          ],
          "properties": {
            "member": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "hitch.defs.schema.json#/$defs/option"
      }
    },
    "remoteApprove": {
      "type": "boolean"
    },
    "urgency": {
      "enum": [
        "low",
        "normal",
        "high"
      ]
    },
    "expires": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "hitch.defs.schema.json#/$defs/time"
        }
      ]
    },
    "onExpire": {
      "enum": [
        "withdraw",
        "expire",
        "fallback"
      ],
      "description": "fallback only for hitch.question@1 with defaultable; never for safety != none."
    },
    "defaultable": {
      "type": "string",
      "description": "hitch.question@1 only: the requester's fallback verb."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Linked item ids."
    },
    "created": {
      "$ref": "hitch.defs.schema.json#/$defs/time"
    },
    "updated": {
      "$ref": "hitch.defs.schema.json#/$defs/time"
    },
    "sig": {
      "$ref": "hitch.defs.schema.json#/$defs/sig"
    },
    "followUp": {
      "type": "string",
      "pattern": "^dec_",
      "description": "outcome uncertain: the hitch.retry@1 decision asking whether to run it again"
    },
    "followUpOf": {
      "type": "string",
      "pattern": "^dec_",
      "description": "hitch.retry@1: the decision whose outcome is uncertain"
    }
  }
}
