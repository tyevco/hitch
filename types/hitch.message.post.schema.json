{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitch.dev/types/hitch.message.post.schema.json",
  "title": "POST /hitch/v1/messages (person-authored)",
  "type": "object",
  "required": ["to", "text"],
  "properties": {
    "to": { "$ref": "hitch.defs.schema.json#/$defs/to" },
    "intent": { "enum": ["message", "task"] },
    "text": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "replyTo": { "type": "string" },
    "idem": { "type": "string", "maxLength": 200 }
  },
  "additionalProperties": false
}
